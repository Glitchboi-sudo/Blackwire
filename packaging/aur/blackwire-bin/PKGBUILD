# Maintainer: glitchboi <glitchboi_mx@proton.com>
pkgname=blackwire-bin
_pkgname=blackwire
pkgver=1.0.0
pkgrel=1
pkgdesc="Blackwire — app de escritorio (Tauri) que corre el backend en un contenedor Docker aislado (binario precompilado del release)"
arch=('x86_64')
url="https://github.com/Glitchboi-sudo/Blackwire"
license=('AGPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'docker')
optdepends=(
  'docker-compose: orquestación del contenedor (si no usas el plugin docker compose)'
  'libappindicator-gtk3: icono en la bandeja del sistema'
)
provides=('blackwire')
conflicts=('blackwire')
options=('!strip' '!debug')
source=("$pkgname-$pkgver.deb::$url/releases/download/v$pkgver/Blackwire_${pkgver}_amd64.deb")
# Reemplaza con el hash real: `updpkgsums`.
sha256sums=('SKIP')

package() {
  # El .deb es un archivo 'ar' con debian-binary + control.tar + data.tar.
  # Se extrae verbatim para preservar binario, recursos (incl. la imagen Docker
  # empaquetada), .desktop e iconos tal como los genera Tauri.
  bsdtar -xf "$srcdir/$pkgname-$pkgver.deb" -C "$srcdir"
  bsdtar -xpf "$srcdir"/data.tar.* -C "$pkgdir"

  # Comando 'blackwire' (symlink al binario instalado por el .deb, sea cual sea su nombre).
  if [ -d "$pkgdir/usr/bin" ] && [ ! -e "$pkgdir/usr/bin/blackwire" ]; then
    _bin="$(find "$pkgdir/usr/bin" -maxdepth 1 -type f -printf '%f\n' | head -n1)"
    [ -n "$_bin" ] && ln -s "$_bin" "$pkgdir/usr/bin/blackwire"
  fi
}
